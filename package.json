{
  "name": "pharmacist-tree-hollow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web-pwa run dev",
    "build": "npm --workspace apps/web-pwa run build",
    "art:dry": "tsx scripts/generate-art.ts",
    "art": "tsx scripts/generate-art.ts --execute",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vercel/node": "^5.8.0",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^16.4.7",
    "openai": "^4.104.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@google/genai": "^2.0.1"
  }
}
