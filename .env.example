# 複製成 .env.local 並填入實際值
# 取得方式：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Vercel KV（Upstash for Redis，Storage 自動注入）
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# 月預算 hard cutoff（optional、YYYY-MM-DD）
# 設了之後當前時間超過該日 /api/respond 直接 503
BUDGET_HARD_CUTOFF_DATE=
